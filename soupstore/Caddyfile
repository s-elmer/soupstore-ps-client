# Serves the built Soup Store client. Runs behind the main Caddy (TLS) in
# soupstore-ps-server/deploy, on an internal port only.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	header -Server
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Scripts only from this site (the client uses inline scripts and eval).
		# connect-src: the game server and PS's login server (password logins go there directly).
		# PokePaste, used by the teambuilder:
		#   - pokepast.es (form-action): "Upload to PokePaste" posts the team to https://pokepast.es/create in a new tab.
		#   - pokepast.es and gist.githubusercontent.com (connect-src): "Import from text or URL" fetches the paste or gist.
		# The Soup Store Showdex extension (https://github.com/s-elmer/soupstore-showdex) also needs:
		#   - Google Fonts: the stylesheet (style-src) and the font files (font-src).
		#   - pkmn.github.io (connect-src): preset data for formats other than Soup Store's. Firefox fetches it from
		#     the page itself (Chrome fetches it from the extension's background script, outside this policy).
		#   - moz-extension: the extension's own scripts, styles, fonts, images and data files, which Firefox loads
		#     into the page under this policy (Chrome exempts extension files, so it doesn't need chrome-extension:).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' moz-extension:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com moz-extension:; img-src 'self' data: blob: https: moz-extension:; media-src 'self' https://play.pokemonshowdown.com; font-src 'self' https://fonts.gstatic.com moz-extension:; connect-src 'self' https://play.pokemonshowdown.com https://pokepast.es https://gist.githubusercontent.com https://pkmn.github.io moz-extension: {$CSP_SERVER_SOURCES:https://showdown.soupstore.dev wss://showdown.soupstore.dev} {$CSP_NEWS_SOURCE:https://replay.soupstore.dev}; frame-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://play.pokemonshowdown.com https://pokepast.es"
	}

	# Sprites and sounds aren't in the client repo; PS hosts them.
	@psassets path /sprites/* /audio/*
	redir @psassets https://play.pokemonshowdown.com{uri} 302

	# The replay site's player runs our js/replay-embed.js, which loads this site's
	# scripts and styles; browsers only use cross-origin fonts with CORS.
	@fonts path /style/fonts/* /style/font/*
	header @fonts Access-Control-Allow-Origin "https://{$REPLAYS_HOST:replay.soupstore.dev}"

	# Replay shortlinks
	redir /r https://{$REPLAYS_HOST:replay.soupstore.dev}/ 302
	@replaylink path_regexp replaylink ^/r/([a-z0-9-]+)$
	redir @replaylink https://{$REPLAYS_HOST:replay.soupstore.dev}/{re.replaylink.1} 302

	# "/" and anything that looks like a room id load the client (mirrors upstream .htaccess)
	@shell path_regexp ^/([A-Za-z0-9][A-Za-z0-9-]*)?$
	handle @shell {
		header Cache-Control "no-cache, no-store, must-revalidate"
		rewrite * /caches/index-old.html
		file_server
	}

	handle {
		# Assets referenced with a ?cachebuster can be cached for a week
		@versioned expression {http.request.uri.query} != ""
		header @versioned Cache-Control "public, max-age=604800"
		file_server
	}
}
